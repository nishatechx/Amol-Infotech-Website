# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key with Places API enabled
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Enquiry Form Email Configuration
EMAIL_TO="22210007@mkcl.org"
EMAIL_FROM="noreply@amolinfotech.in"
# SMTP Settings (optional, for direct SMTP delivery)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Or Resend API key (optional alternative)
RESEND_API_KEY=""

# Cloudinary Signed Upload Credentials (Server-side secrets ONLY)
# Configure these in Cloudflare Pages dashboard -> Settings -> Environment Variables
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Centre Director Security & Auth Verification
# 1. Firebase Authentication:
# Set your Firebase Project ID to verify Firebase ID tokens at the edge
FIREBASE_PROJECT_ID=""
# Optional: Specific director email address authorized to upload
DIRECTOR_EMAIL="director@amolinfotech.in"

# 2. Centre Director Authorization Secret (Shared Secret fallback for Director session)
DIRECTOR_AUTH_SECRET=""

